# Port the server listens on.
PORT=3000
# Where call-back requests are stored (JSON Lines).
LEADS_FILE=data/leads.jsonl
# Set to enable GET /api/leads (send "Authorization: Bearer <token>"). Leave empty to disable the route.
LEADS_TOKEN=
# Form submissions allowed per client per minute (default 10).
RATE_LIMIT=
# Set to 1 when running behind a load balancer / reverse proxy, so rate limiting sees the real client IP.
TRUST_PROXY=
# reCAPTCHA v3 site key the page uses for the CRM (public). Staging and production use different keys.
# Unset: the page falls back to the production key built into public/app.js.
RECAPTCHA_SITE_KEY=
# Tradeling CRM: every call-back request is also sent here (POST, JSON). Leave empty to keep leads local only.
# Stage: https://api.tradelingstage.com/api/www/v1/leads
CRM_LEADS_URL=
# CRM API key (stage or production). Set it in the host's environment or a local .env; never commit it.
CRM_API_KEY=
# form_type sent with every lead (default POS). The CRM currently accepts: b2b mart, enterprise, exchange,
# distribution, logistics, ads — POS still has to be added on the CRM side.
CRM_FORM_TYPE=
# buyer_segment sent with every lead: sme (default) or enterprise — the only values the CRM accepts.
CRM_BUYER_SEGMENT=
# Header the key is sent in.
CRM_API_KEY_HEADER=x-api-key
