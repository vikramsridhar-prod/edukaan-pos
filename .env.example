# Port the server listens on.
PORT=3000
# Where call-back requests are stored (JSON Lines).
LEADS_FILE=data/leads.jsonl
# Set to enable GET /api/leads (send "Authorization: Bearer <token>"). Leave empty to disable the route.
LEADS_TOKEN=
# Set to 1 when running behind a load balancer / reverse proxy, so rate limiting sees the real client IP.
TRUST_PROXY=
